# Align with former CI `npm ci --legacy-peer-deps` until peer graphs are cleaned up.
# pnpm ignores npm-only legacy-peer-deps; pnpm v8+ defaults strict-peer-dependencies=true.
strict-peer-dependencies=false
legacy-peer-deps=true
# Vercel/CI에서 전역 engine-strict=true일 때 engines.node(22.x)와 UI Node 버전 불일치로 install이 실패하는 것을 막음
engine-strict=false
