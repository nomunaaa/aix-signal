# Copy to .env.local (or set in Vercel Dashboard for prod/preview).
# 런타임은 Next.js 14 App Router. 클라이언트 공개 키는 모두 `NEXT_PUBLIC_*` 접두사를 사용한다.
# 서버 전용 시크릿(예: SUPABASE_SERVICE_ROLE_KEY)은 접두사 없이 선언한다.
# 구 `VITE_*` 키는 마이그레이션 중에 호환성 위해 readPublic()이 자동 매핑하지만 신규 사용 금지.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_PROJECT_ID=your_supabase_project_id
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# --- WebSocket / REST ---
NEXT_PUBLIC_WS_URL=wss://stream.binance.com:9443/ws
NEXT_PUBLIC_REST_URL=https://api.binance.com/api/v3
# USDT 마켓 24h quoteVolume 상위 예시(스테이블·레버리지 심볼 제외 스냅샷). 운영 시 주기적으로 갱신 권장.
NEXT_PUBLIC_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,ZECUSDT,XRPUSDT,TAOUSDT,FFUSDT,DOGEUSDT,BNBUSDT,DASHUSDT,XAUTUSDT,PEPEUSDT,ADAUSDT,TRXUSDT,NOMUSDT,WLFIUSDT,SUIUSDT,LPTUSDT,WLDUSDT,TONUSDT,ENAUSDT,ARBUSDT,AVAXUSDT,ZAMAUSDT,LINKUSDT,GIGGLEUSDT,PARTIUSDT,FETUSDT,PAXGUSDT,NEARUSDT
NEXT_PUBLIC_DEFAULT_INTERVAL=5m

# --- Delay / UX ---
NEXT_PUBLIC_DELAY_FACTOR=2
NEXT_PUBLIC_DELAY_TOAST_TTL=8000

# --- Volatility (ATR%) ---
NEXT_PUBLIC_VOL_CUT_LOW=1.0
NEXT_PUBLIC_VOL_CUT_NORMAL=2.5
NEXT_PUBLIC_ATR_PERIOD=14

# --- Edge / trust params ---
NEXT_PUBLIC_EDGE_C=0.02
NEXT_PUBLIC_EDGE_TAU=0.01
NEXT_PUBLIC_TRUST_MIN_N=50
NEXT_PUBLIC_TRUST_PRIOR_MU=0.55
NEXT_PUBLIC_TRUST_PRIOR_N0=200

# --- Third-party (replace with your keys) ---
NEXT_PUBLIC_NOVU_APP_ID=your_novu_app_id
PINATA_JWT=your_pinata_jwt

NEXT_PUBLIC_TG_BOT_NAME=your_bot_name
NEXT_PUBLIC_PARTNERO_PROGRAM_ID=your_program_id
# Partnero REST (Supabase Edge 시크릿 PARTNERO_API_KEY와 동일). 로컬에서만 선택적으로 넣고
# `scripts/verify-partnero-edge-functions.sh`로 API 키 스모크 시 사용 — 커밋 금지.
# PARTNERO_API_KEY=

# --- PostHog ---
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- REST (프로덕션·원격 연동). 로컬 `pnpm dev` + MSW 목은 Pulse가 기본으로 이 값을 무시함. ---
# NEXT_PUBLIC_API_BASE_URL=https://api.example.com
# DEV에서 실제 Pulse API만 직접 칠 때:
# NEXT_PUBLIC_USE_REAL_PULSE_API=true

# --- Pulse board — mini price series (`docs/api/pulse-signals.md`) ---
# 기본: 생략 또는 allow_synthetic — API에 sparkline_24h 없을 때 참고용 합성 곡선
# 스테이징 검증: api-only (합성 끔, 빈 칸·문구만)
# NEXT_PUBLIC_PULSE_CHART_SOURCE=api-only

# --- Mock (AIX-86) — `src/lib/env/mock.ts` 참고 ---
# NEXT_PUBLIC_USE_MOCK=true
# NEXT_PUBLIC_USE_MOCK_TREND=true
# NEXT_PUBLIC_USE_MOCK_SIGNALS=true
# NEXT_PUBLIC_USE_MOCK_SIGNAL_DETAIL=true
# NEXT_PUBLIC_USE_MOCK_CHART=true
# NEXT_PUBLIC_USE_MOCK_MY=true
# NEXT_PUBLIC_USE_MOCK_PROOF=true
# NEXT_PUBLIC_USE_MOCK_MARKET_COMMENTARY=true
# 인사이트 단독(마스터 없이): NEXT_PUBLIC_USE_MOCK_INSIGHTS=true (또는 1)
