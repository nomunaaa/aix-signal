{
  "name": "aixsignal-core",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "next dev -p 8080",
    "build": "next build",
    "build:dev": "next build",
    "lint": "eslint . --cache --cache-location .next/cache/eslint/.eslintcache",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "type-check": "node -e \"require('node:fs').mkdirSync('.next/cache/typescript', { recursive: true })\" && tsc --noEmit --tsBuildInfoFile .next/cache/typescript/typecheck.tsbuildinfo",
    "type-check:stories": "tsc --noEmit -p tsconfig.stories.json",
    "quality": "pnpm run lint && pnpm run format:check && pnpm run type-check",
    "quality:fix": "pnpm run lint:fix && pnpm run format",
    "security": "pnpm run security:audit && pnpm run security:secrets && pnpm run security:env",
    "security:audit": "pnpm audit --audit-level=moderate",
    "security:secrets": "bash scripts/check-secrets.sh",
    "security:env": "bash scripts/check-env.sh",
    "security:fix": "pnpm audit --fix",
    "analyze:design": "bash scripts/analyze-design-system.sh",
    "analyze:architecture": "tsx scripts/analyze-architecture.ts",
    "validate:pages": "tsx scripts/validate-pages.ts",
    "audit:routes": "tsx scripts/route-completion-audit-app.ts",
    "validate:design-system": "echo '🔍 디자인 시스템 검증...' && find src/components -name '*.tsx' | wc -l && echo '컴포넌트 스캔 완료. DESIGN_SYSTEM_DEEP_ANALYSIS.md 참고'",
    "analyze:all": "pnpm run quality && pnpm run security && pnpm run analyze:design",
    "report:daily": "echo '📊 Daily Report 생성 중...' && date && pnpm run quality && pnpm run security",
    "preview": "next start -p 8080",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "backtest": "tsx scripts/backtest.ts",
    "backup:prod": "bash scripts/prod_backup_partial.sh",
    "backup:prod:full": "bash scripts/prod_backup_full.sh",
    "backup:prod:upload": "bash scripts/prod_upload_to_supabase.sh",
    "backup:prod:restore": "bash scripts/prod_restore_from_backup.sh",
    "backup:prod:download": "bash scripts/prod_download_from_supabase.sh",
    "backup:prod:partial": "pnpm run backup:prod && pnpm run backup:prod:upload",
    "backup:local": "bash scripts/local_backup.sh",
    "deploy:check": "bash scripts/pre-push-check.sh",
    "deploy:setup-hooks": "bash scripts/install-git-hooks.sh",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static --quiet --disable-telemetry",
    "storybook:preview": "pnpm run build-storybook && pnpm dlx serve storybook-static -p 6006"
  },
