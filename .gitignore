# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist

# Next.js
.next/
out/

# Root only: canonical package manager is pnpm (package.json#packageManager).
# A committed npm lockfile makes Corepack/Vercel report npm vs pnpm mismatch.
/package-lock.json

# Environment (secrets — keep only template in git)
.env
.env.*
!.env.example
# Cloudflare API token for docs/infra/n8n-self-hosted/scripts/provision-cf-tunnel.sh
docs/infra/n8n-self-hosted/.cf-api-token
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
storybook-static/
dist-storybook/
.pnpm-store/
.sisyphus/
.cursor/
.sonarlint/


# MCP config (contains API keys)
.mcp.json

# Supabase CLI local state
supabase/.temp/

# Test templates and archives
tests/
.vercel

# Local regression tests
**/__tests__/

# Oh-my-claudecode / OMC — 세션·메모리·플랜 (기기별, 저장소에 포함하지 않음)
.omc/

# Claude Code — 로컬 오버라이드·락 (팀 공유는 settings.json·CLAUDE.md·skills 등만)
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Root-level temp files (leading slash scopes to root only)
/*.sql
/*.txt
/*.sh
/*.ps1
/*.jsonl
/*.png
/*.jpeg
/*.jpg

# Package manager locks
# pnpm-lock.yaml — CI requires this (--frozen-lockfile)
pnpm-workspace.yaml
bun.lockb

# AI agent configs
*_agent_config.*

# Legacy tool configs
.hintrc
.cursorrules
sonar-project.properties

# Playwright MCP screenshots
.playwright-mcp/

# Playwright test run artifacts (REF-004)
test-results/
playwright-report/

# AI context
.ai-context/

# TypeScript incremental build info (generated; do not commit)
tsconfig.tsbuildinfo

# Agent / CE pipeline artifacts (keep local only unless team policy changes)
.context/

# Compound Engineering — machine-local YAML (see references/config-template.yaml)
.compound-engineering/*.local.yaml
